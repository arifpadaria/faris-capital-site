{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".github/**",
      ".git/**",
      "archive/**",
      "scripts/**",
      "logo building directory/**",
      "**/*.md",
      "**/*.sh",
      "firebase-hosting-instructions",
      "email-signature.html"
    ],
    "redirects": [
      { "source": "/ventures.html", "destination": "/what-we-do.html#ventures", "type": 301 },
      { "source": "/institutional-capital.html", "destination": "/what-we-do.html#capital", "type": 301 },
      { "source": "/enterprises.html", "destination": "/what-we-do.html#enterprises", "type": 301 },
      { "source": "/growth-advisory.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/capital-alignment.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/corporate-development.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/capital-platforms.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/global-markets.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/venture-builder.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/advisory.html", "destination": "/what-we-do.html", "type": 301 },
      { "source": "/theses/the-gap-noboby-at-automate-has-named-yet.html", "destination": "/theses/the-gap-nobody-at-automate-has-named-yet.html", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
